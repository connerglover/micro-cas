      "css": ".ds-transfer{border-top:1px solid var(--line,#d4dbe5);padding:23px 26px 19px}.ds-transfer-heading{display:flex;justify-content:space-between;gap:16px;font-size:12px;font-weight:550;min-height:20px}.ds-transfer-heading .ds-numeric{color:var(--muted,#586579);white-space:nowrap}.ds-progress{appearance:none;border:0;border-radius:0;width:100%;height:3px;margin:13px 0 21px;display:block;background:#e5e9f0;overflow:hidden}.ds-progress::-webkit-progress-bar{background:#e5e9f0}.ds-progress::-webkit-progress-value{background:var(--blue,#2144ad)}.ds-progress::-moz-progress-bar{background:var(--blue,#2144ad)}.ds-file-map{display:grid;grid-template-columns:repeat(34,minmax(0,1fr));gap:4px;min-height:86px;align-content:start}.ds-file-cell{aspect-ratio:1;background:#e5e9f0;border:1px solid #d9e0ea;border-radius:1px;transition:background .18s ease-out,border-color .18s ease-out}.ds-file-cell.ds-sending{background:var(--blue,#2144ad);border-color:var(--blue,#2144ad)}.ds-file-cell.ds-sent{background:#719c86;border-color:#719c86}.ds-file-cell.ds-verified{background:var(--green,#21644d);border-color:var(--green,#21644d)}.ds-file-cell.ds-failed{background:#b75d3f;border-color:#b75d3f}.ds-map-caption{display:flex;justify-content:space-between;gap:10px;margin-top:13px;font-size:12px;color:var(--muted,#586579)}.ds-integrity{white-space:nowrap}.ds-integrity.ds-verified{color:var(--green,#21644d)}.ds-transfer{font-family:var(--font,\"Public Sans\",sans-serif);font-size:15px;line-height:1.55;color:var(--ink,#202a3b);background:var(--paper,#fff)}.ds-numeric{font-variant-numeric:tabular-nums}@media(max-width:1000px){.ds-file-map{grid-template-columns:repeat(28,minmax(0,1fr));gap:3px}}@media(max-width:700px){.ds-transfer{padding:20px}.ds-file-map{min-height:90px}}@media(prefers-reduced-motion:reduce){.ds-file-cell{transition:none}}",
