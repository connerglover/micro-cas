  "narrative": {
    "northStar": "The File Workspace",
    "overview": "The File Workspace gives the installer the clarity of a desktop file manager: a white working surface on cool silver, direct Public Sans labels, restrained ink-blue selection, and literal representations of package files. Its character is calm, compact and inspectable. Filename and diagnostic text use monospace; the surrounding interface uses proportional type.\n\nState carries the visual emphasis. Solid blue identifies the next action and current work; green identifies a specific verified or completed condition. Rules and tonal changes divide information without shadows. This record describes the implemented web interface, with the durable accessibility and direct-language commitments in PRODUCT.md.\n\nThis is an extracted record of website/index.html, website/styles.css and website/app.js, not an approved comp. The session used autonomous, code-led implementation; it establishes no lasting build-path preference. The surface composition and direction remain in .impeccable/surfaces/website-index-html.md. docs/DESIGN.md documents the calculator engine and is separate from this UI system.",
    "keyCharacteristics": [
      "A light file workspace with crisp rules and restrained state color.",
      "Public Sans interface text; monospace filenames and local diagnostics.",
      "One advancing primary action beside an inspectable package.",
      "Literal file progress with a filename, count and textual state.",
      "Responsive stacking, visible focus and reduced-motion support."
    ],
    "rules": [
      {
        "name": "The State Evidence Rule",
        "body": "Color accompanies a named state and a count or message; it never supplies the only indication of progress or completion.",
        "section": "colors"
      },
      {
        "name": "The Filename Rule",
        "body": "Reserve monospace for filenames and diagnostics; keep the operating instructions and interface hierarchy in Public Sans.",
        "section": "typography"
      },
      {
        "name": "The Surface Rule",
        "body": "Separate working regions with tone and rules; retain the flat material language of the installed interface.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do pair state color with textual status and numeric progress.",
      "Do use Public Sans for the interface and monospace for filenames and diagnostics.",
      "Do preserve visible keyboard focus, semantic controls and reduced-motion behavior.",
      "Do keep required archive and RAM destinations visible and automatic.",
      "Do treat package verification, file-location verification and calculator execution as separate conditions."
    ],
    "donts": [
      "Don't turn the static package tag into a destination toggle.",
      "Don't use the pending or success file colors as decorative progress.",
      "Don't claim a connected or installed device from the package-ready screenshot.",
      "Don't replace the flat workspace hierarchy with shadows or individually boxed file rows.",
      "Don't treat this session's code-led implementation as a standing workflow preference."
    ]
  }
}
